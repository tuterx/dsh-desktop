{
  "name": "@deepseek-ai/dsh-host-electron",
  "description": "[BETA] Desktop surface plugin: spawns an Electron window over the dsh web server, carrying RPC over an IPC bridge instead of the browser HTTP/WebSocket carrier",
  "version": "0.1.0-beta.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuterx/dsh-desktop.git",
    "directory": "plugins/dsh-host-electron"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/electron-main.cjs",
    "lib/preload.cjs",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "electron",
    "desktop",
    "deepseek-harness",
    "beta"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.5"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.5",
    "typescript": "^6.0.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown --config tsdown.config.ts",
    "typecheck": "tsc --noEmit"
  }
}
